=\"captions-window-vjs_video_1903_component_2467 captions-window-opacity-vjs_video_1903_component_2467 captions-window-opacity-vjs_video_1903_component_2467-Opaque\">Opaque</option></select></span></fieldset></div><div class=\"vjs-track-settings-font\"><fieldset class=\"vjs-font-percent vjs-track-setting\"><legend id=\"captions-font-size-vjs_video_1903_component_2467\">Font Size</legend><select id=\"vjs_select_2544\" aria-labelledby=\"captions-font-size-vjs_video_1903_component_2467\"><option id=\"vjs-track-option-2545-50\" value=\"0.50\" aria-labelledby=\"captions-font-size-vjs_video_1903_component_2467 vjs-track-option-2545-50\">50%</option><option id=\"vjs-track-option-2546-75\" value=\"0.75\" aria-labelledby=\"captions-font-size-vjs_video_1903_component_2467 vjs-track-option-2546-75\">75%</option><option id=\"vjs-track-option-2547-100\" value=\"1.00\" aria-labelledby=\"captions-font-size-vjs_video_1903_component_2467 vjs-track-option-2547-100\">100%</option><option id=\"vjs-track-option-2548-125\" value=\"1.25\" aria-labelledby=\"captions-font-size-vjs_video_1903_component_2467 vjs-track-option-2548-125\">125%</option><option id=\"vjs-track-option-2549-150\" value=\"1.50\" aria-labelledby=\"captions-font-size-vjs_video_1903_component_2467 vjs-track-option-2549-150\">150%</option><option id=\"vjs-track-option-2550-175\" value=\"1.75\" aria-labelledby=\"captions-font-size-vjs_video_1903_component_2467 vjs-track-option-2550-175\">175%</option><option id=\"vjs-track-option-2551-200\" value=\"2.00\" aria-labelledby=\"captions-font-size-vjs_video_1903_component_2467 vjs-track-option-2551-200\">200%</option><option id=\"vjs-track-option-2552-300\" value=\"3.00\" aria-labelledby=\"captions-font-size-vjs_video_1903_component_2467 vjs-track-option-2552-300\">300%</option><option id=\"vjs-track-option-2553-400\" value=\"4.00\" aria-labelledby=\"captions-font-size-vjs_video_1903_component_2467 vjs-track-option-2553-400\">400%</option></select></fieldset><fieldset class=\"vjs-edge-style vjs-track-setting\"><legend id=\"captions-edge-style-vjs_video_1903_component_2467\">Text Edge Style</legend><select id=\"vjs_select_2563\" aria-labelledby=\"captions-edge-style-vjs_video_1903_component_2467\"><option id=\"vjs-track-option-2564-None\" value=\"none\" aria-labelledby=\"captions-edge-style-vjs_video_1903_component_2467 vjs-track-option-2564-None\">None</option><option id=\"vjs-track-option-2565-Raised\" value=\"raised\" aria-labelledby=\"captions-edge-style-vjs_video_1903_component_2467 vjs-track-option-2565-Raised\">Raised</option><option id=\"vjs-track-option-2566-Depressed\" value=\"depressed\" aria-labelledby=\"captions-edge-style-vjs_video_1903_component_2467 vjs-track-option-2566-Depressed\">Depressed</option><option id=\"vjs-track-option-2567-Uniform\" value=\"uniform\" aria-labelledby=\"captions-edge-style-vjs_video_1903_component_2467 vjs-track-option-2567-Uniform\">Uniform</option><option id=\"vjs-track-option-2568-Dropshadow\" value=\"dropshadow\" aria-labelledby=\"captions-edge-style-vjs_video_1903_component_2467 vjs-track-option-2568-Dropshadow\">Drop shadow</option></select></fieldset><fieldset class=\"vjs-font-family vjs-track-setting\"><legend id=\"captions-font-family-vjs_video_1903_component_2467\">Font Family</legend><select id=\"vjs_select_2578\" aria-labelledby=\"captions-font-family-vjs_video_1903_component_2467\"><option id=\"vjs-track-option-2579-ProportionalSansSerif\" value=\"proportionalSansSerif\" aria-labelledby=\"captions-font-family-vjs_video_1903_component_2467 vjs-track-option-2579-ProportionalSansSerif\">Proportional Sans-Serif</option><option id=\"vjs-track-option-2580-MonospaceSansSerif\" value=\"monospaceSansSerif\" aria-labelledby=\"captions-font-family-vjs_video_1903_component_2467 vjs-track-option-2580-MonospaceSansSerif\">Monospace Sans-Serif</option><option id=\"vjs-track-option-2581-ProportionalSerif\" value=\"proportionalSerif\" aria-labelledby=\"captions-font-family-vjs_video_1903_component_2467 vjs-track-option-2581-ProportionalSerif\">Proportional Serif</option><option id=\"vjs-track-option-2582-MonospaceSerif\" value=\"monospaceSerif\" aria-labelledby=\"captions-font-family-vjs_video_1903_component_2467 vjs-track-option-2582-MonospaceSerif\">Monospace Serif</option><option id=\"vjs-track-option-2583-Casual\" value=\"casual\" aria-labelledby=\"captions-font-family-vjs_video_1903_component_2467 vjs-track-option-2583-Casual\">Casual</option><option id=\"vjs-track-option-2584-Script\" value=\"script\" aria-labelledby=\"captions-font-family-vjs_video_1903_component_2467 vjs-track-option-2584-Script\">Script</option><option id=\"vjs-track-option-2585-SmallCaps\" value=\"small-caps\" aria-labelledby=\"captions-font-family-vjs_video_1903_component_2467 vjs-track-option-2585-SmallCaps\">Small Caps</option></select></fieldset></div><div class=\"vjs-track-settings-controls\"><button class=\"vjs-default-button\" type=\"button\" title=\"restore all settings to the default values\" aria-disabled=\"false\">Reset</button><button class=\"vjs-done-button\" type=\"button\" title=\"Done\" aria-disabled=\"false\">Done</button></div></div><button class=\"vjs-close-button vjs-control vjs-button\" type=\"button\" title=\"Close Modal Dialog\" aria-disabled=\"false\"><span class=\"vjs-icon-placeholder\" aria-hidden=\"true\"></span><span class=\"vjs-control-text\" aria-live=\"polite\">Close Modal Dialog</span></button><p class=\"vjs-control-text\">End of dialog window.</p></div></video-js></div></div></div>\n<h2 style=\"font-size: 1rem; line-height: 1.5rem; margin-top: 1rem;\">基础操作入门</h2>\n<div><strong>目标</strong>：学会创建仓库、上传代码、协作开发的基础操作。</div>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">注册账号</h3>\n<ol>\n<li>访问 <a href=\"https://github.com\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub官网</a></li>\n<li>点击右上角 <strong>Sign up</strong>，填写邮箱、密码、用户名</li>\n<li>验证邮箱后完成注册（提示检查邮箱收验证邮件）</li>\n</ol>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">创建仓库</h3>\n<ol>\n<li>登录后点击右上角 <strong>+ → New repository</strong></li>\n<li>填写仓库信息：\n<ul>\n<li><strong>Repository name</strong>：项目名称（如 <code>my-first-project</code>）</li>\n<li><strong>Description</strong>：项目描述（可选）</li>\n<li>勾选 <strong>Add a README file</strong>（建议创建初始说明文件）</li>\n<li>点击 <strong>Create repository</strong></li>\n</ul>\n</li>\n</ol>\n<div><img src=\"https://scysoss.oss-cn-beijing.aliyuncs.com/scys-images/f4sknyvk76_img1.webp\" alt=\"创建仓库\" loading=\"lazy\"></div>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">上传代码</h3>\n<h4>方法1：网页直接上传</h4>\n<ol>\n<li>进入仓库页面，点击 <strong>Add file → Upload files</strong></li>\n<li>拖拽本地代码文件夹到网页区域，或点击 <strong>choose your files</strong> 选择文件</li>\n<li>输入提交描述（如\"首次提交代码\"），点击 <strong>Commit changes</strong></li>\n</ol>\n<div><img src=\"https://scysoss.oss-cn-beijing.aliyuncs.com/scys-images/f4sknyvk76_img2.webp\" alt=\"上传代码\" loading=\"lazy\"></div>\n<h4>方法2：使用GitHub Desktop</h4>\n<ol>\n<li>下载安装 <a href=\"https://desktop.github.com/\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub Desktop</a></li>\n<li>登录账号，选择仓库 → <strong>Clone Repository</strong></li>\n<li>将本地代码复制到仓库文件夹，返回GitHub Desktop提交并推送（同步）</li>\n</ol>\n<h2 style=\"font-size: 1rem; line-height: 1.5rem; margin-top: 1rem;\">团队协作功能</h2>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">添加协作者</h3>\n<ol>\n<li>进入仓库 → <strong>Settings → Collaborators</strong></li>\n<li>输入对方GitHub用户名 → <strong>Add collaborator</strong></li>\n</ol>\n<div><img src=\"https://scysoss.oss-cn-beijing.aliyuncs.com/scys-images/f4sknyvk76_img3.webp\" alt=\"添加协作者\" loading=\"lazy\"></div>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">使用Issues</h3>\n<ol>\n<li>进入仓库 → <strong>Issues → New Issue</strong></li>\n<li>填写任务标题和描述（如\"修复登录页面错误\"）</li>\n<li>点击 <strong>Submit new issue</strong></li>\n</ol>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">发起Pull Request</h3>\n<ol>\n<li>在仓库页面点击 <strong>Pull requests → New pull request</strong></li>\n<li>选择要合并的分支（如 <code>main</code> ← <code>feature-branch</code>）</li>\n<li>填写修改说明，点击 <strong>Create pull request</strong></li>\n</ol>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">分支管理</h3>\n<ol>\n<li>进入仓库 → 点击分支下拉框（默认显示 <code>main</code>）</li>\n<li>输入新分支名（如 <code>fix-header</code>） → <strong>Create branch</strong></li>\n<li>修改代码后提交，自动保存到新分支</li>\n</ol>\n<h2 style=\"font-size: 1rem; line-height: 1.5rem; margin-top: 1rem;\">使用他人的代码</h2>\n<div><strong>目标</strong>：学会获取他人仓库的代码，并在本地运行项目。</div>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">下载代码的方法</h3>\n<h4>方法1：下载ZIP压缩包</h4>\n<ol>\n<li>打开目标仓库页面（例如搜索 <code>python simple-game</code> 找到项目）</li>\n<li>点击绿色 <strong>Code</strong> 按钮 → <strong>Download ZIP</strong></li>\n<li>解压ZIP文件到本地文件夹即可查看代码</li>\n</ol>\n<h4>方法2：使用GitHub Desktop克隆</h4>\n<ol>\n<li>安装 <a href=\"https://desktop.github.com/\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub Desktop</a> 并登录</li>\n<li>在仓库页面点击 <strong>Code → Open with GitHub Desktop</strong></li>\n<li>选择本地保存路径 → 点击 <strong>Clone</strong>，代码自动下载到指定文件夹</li>\n</ol>\n<h4>方法3：通过仓库URL获取</h4>\n<ol>\n<li>复制仓库页面地址栏的URL（如 <code>https://github.com/用户名/仓库名</code>）</li>\n<li>发送给协作者或自行保存，方便后续访问</li>\n</ol>\n<div><img src=\"https://scysoss.oss-cn-beijing.aliyuncs.com/scys-images/f4sknyvk76_img4.webp\" alt=\"克隆仓库\" loading=\"lazy\"></div>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">运行项目步骤</h3>\n<h4>检查项目说明</h4>\n<ol>\n<li>打开仓库，查看根目录的 <strong>README.md</strong> 文件</li>\n<li>根据说明安装所需环境（如Python、Node.js等）</li>\n</ol>\n<h4>安装依赖库</h4>\n<ol>\n<li>如果项目包含 <code>requirements.txt</code>（Python）或 <code>package.json</code>（JavaScript）：\n<ul>\n<li><strong>Python项目</strong>：命令行运行 <code>pip install -r requirements.txt</code></li>\n<li><strong>JavaScript项目</strong>：命令行运行 <code>npm install</code></li>\n</ul>\n</li>\n</ol>\n<h4>启动项目</h4>\n<ol>\n<li>根据README指示执行启动命令，例如：\n<ul>\n<li>Python脚本：<code>python main.py</code></li>\n<li>Web项目：<code>npm start</code> 或点击 <code>index.html</code> 用浏览器打开</li>\n</ul>\n</li>\n</ol>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">注意事项</h3>\n<div>⚠️ <strong>务必注意</strong>：</div>\n<ol>\n<li><strong>检查许可证</strong>：仓库是否有<code>LICENSE</code>文件，确认允许代码使用/修改</li>\n<li><strong>安全提醒</strong>：不要随意运行未知来源的代码，防止恶意程序</li>\n<li><strong>环境问题</strong>：若运行报错，先检查是否缺少依赖库或版本不匹配</li>\n</ol>\n<h2 style=\"font-size: 1rem; line-height: 1.5rem; margin-top: 1rem;\">项目交互功能</h2>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">Star项目</h3>\n<ol>\n<li>在任意仓库页面点击右上角的 <strong>Star</strong> 按钮</li>\n<li>项目会被添加到你的 Star 列表中</li>\n<li>查看已收藏项目：点击个人头像 → <strong>Your stars</strong></li>\n</ol>\n<div><img src=\"https://scysoss.oss-cn-beijing.aliyuncs.com/scys-images/f4sknyvk76_img5.webp\" alt=\"Star项目\" loading=\"lazy\"></div>\n<h4>Star的作用</h4>\n<ul>\n<li>收藏感兴趣的项目，方便日后查看</li>\n<li>表达对项目的支持和认可</li>\n<li>关注项目更新（可开启通知）</li>\n</ul>\n<h3 style=\"font-size: 0.875rem; line-height: 1.25rem; margin-top: 1rem;\">Fork项目</h3>\n<ol>\n<li>在仓库页面点击右上角 <strong>Fork</strong> 按钮</li>\n<li>选择保存到你的账号下（可选择性修改仓库名）</li>\n<li>等待片刻，项目将被复制到你的账号中</li>\n</ol>\n<h4>Fork的用途</h4>\n<ul>\n<li>基于他人项目开发新功能</li>\n<li>修复原项目的Bug并贡献代码</li>\n<li>学习项目源码（可随意修改不影响原项目）</li>\n</ul>\n<h4>Fork后的操作建议</h4>\n<ol>\n<li>及时同步原仓库更新：\n<ul>\n<li>点击 <strong>Sync fork</strong> 按钮</li>\n<li>选择 <strong>Update branch</strong> 更新到最新版本</li>\n</ul>\n</li>\n<li>如需贡献代码：\n<ul>\n<li>在自己的Fork中修改代码</li>\n<li>通过Pull Request提交给原仓库</li>\n</ul>\n</li>\n</ol>",
