  "title": "【2024.4.16案例拆解】Jobs Board SaaS",
  "author": "哥飞",
  "authorAvatar": "https://scysoss.oss-cn-beijing.aliyuncs.com/scys-images/9b3o6d2pzd_avatar.jpg",
