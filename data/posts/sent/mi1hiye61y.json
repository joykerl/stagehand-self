le_upload_element</span><span class=\"token\" style=\"color: rgb(153, 153, 153);\">(</span><span class=\"token\" style=\"color: rgb(153, 153, 153);\">)</span><span>\n</span>\n<span>\t</span><span class=\"token control-flow\" style=\"color: rgb(0, 119, 170);\">if</span><span> file_upload_dom_el is </span><span class=\"token maybe-class-name\">None</span><span class=\"token\" style=\"color: rgb(154, 110, 58); background: rgba(255, 255, 255, 0.5);\">:</span><span>\n</span><span>\t\tmsg </span><span class=\"token\" style=\"color: rgb(154, 110, 58); background: rgba(255, 255, 255, 0.5);\">=</span><span> f</span><span class=\"token\" style=\"color: rgb(102, 153, 0);\">'No file upload element found at index {index}'</span><span>\n</span><span>\t\t</span><span class=\"token\" style=\"color: rgb(221, 74, 104);\">print</span><span class=\"token\" style=\"color: rgb(153, 153, 153);\">(</span><span>msg</span><span class=\"token\" style=\"color: rgb(153, 153, 153);\">)</span><span>\n</span><span>\t\t</span><span class=\"token control-flow\" style=\"color: rgb(0, 119, 170);\">return</span><span> </span><span class=\"token maybe-class-name\" style=\"color: rgb(221, 74, 104);\">ActionResult</span><span class=\"token\" style=\"color: rgb(153, 153, 153);\">(</span><span>error</span><span class=\"token\" style=\"color: rgb(154, 110, 58); background: rgba(255, 255, 255, 0.5);\">=</span><span>msg</span><span class=\"token\" style=\"color: rgb(153, 153, 153);\">)</span><span>\n</span>\n<span>\tfile_upload_el </span><span class=\"token\" style=\"color: rgb(154, 110, 58); background: rgba(255, 255, 255, 0.5);\">=</span><span> </span><span class=\"token control-flow\" style=\"color: rgb(0, 119, 170);\">await</span><span> browser</span><span class=\"token\" style=\"color: rgb(153, 153, 153);\">.</span><span class=\"token method property-access\" style=\"color: rgb(221, 74, 104);\">get_locate_element</span><span class=\"token\" style=\"color: rgb(153, 153, 153);\">(</span><span>file_upload_do